rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function isRole(roleName) {
      return isAuthenticated() && (
        getUserData().role == roleName || 
        getUserData().role == roleName.lower()
      );
    }

    function isAdmin() {
      return isRole('admin') || isRole('superadmin') || isRole('super_admin');
    }

    function isStudent() {
      return isRole('student');
    }

    function isPrincipal() {
      return isRole('principal') || isAdmin();
    }

    function isHOD() {
      return isRole('hod') || isPrincipal();
    }

    function isFaculty() {
      return isRole('faculty') || isHOD();
    }

    function isPlacementOfficer() {
      return isRole('placement') || isRole('placement_officer') || isAdmin();
    }

    function isCounsellor() {
      return isRole('counsellor') || isHOD();
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        request.auth.token.email == userId
      );
    }

    // Profiles Collection (all roles)
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin() || isPrincipal() || isHOD());
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isPrincipal() || isHOD() || isFaculty());
    }

    // Faculty Collection
    match /faculty/{facultyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isPrincipal() || isHOD());
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isFaculty() || isAdmin();
    }

    // Assignment Submissions
    match /assignment_submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Study Notes & Materials
    match /notes/{noteId} {
      allow read: if isAuthenticated();
      allow write: if isFaculty() || isAdmin();
    }
    match /study_materials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isFaculty() || isAdmin();
    }

    // Attendance Records
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isFaculty() || isAdmin();
    }

    // Attendance History
    match /attendanceHistory/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isFaculty() || isAdmin();
    }
    match /attendance_history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isFaculty() || isAdmin();
    }

    // Attendance Edit Requests
    match /attendance_edit_requests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isFaculty() || isAdmin();
    }

    // Internal Marks
    match /internalMarks/{markId} {
      allow read: if isAuthenticated();
      allow write: if isFaculty() || isAdmin();
    }
    match /internal_marks/{markId} {
      allow read: if isAuthenticated();
      allow write: if isFaculty() || isAdmin();
    }
    match /marks/{markId} {
      allow read: if isAuthenticated();
      allow write: if isFaculty() || isAdmin();
    }
    match /assignment_marks/{markId} {
      allow read: if isAuthenticated();
      allow write: if isFaculty() || isAdmin();
    }

    // Placement Drives & Companies
    match /placement_drives/{driveId} {
      allow read: if isAuthenticated() && (isAdmin() || isPlacementOfficer() || isStudent());
      allow write: if isAdmin() || isPlacementOfficer();
    }
    match /placementDrives/{driveId} {
      allow read: if isAuthenticated() && (isAdmin() || isPlacementOfficer() || isStudent());
      allow write: if isAdmin() || isPlacementOfficer();
    }
    match /placement_companies/{companyId} {
      allow read: if isAuthenticated() && (isAdmin() || isPlacementOfficer() || isStudent());
      allow write: if isAdmin() || isPlacementOfficer();
    }
    match /companies/{companyId} {
      allow read: if isAuthenticated() && (isAdmin() || isPlacementOfficer() || isStudent());
      allow write: if isAdmin() || isPlacementOfficer();
    }

    // Placement Applications & Resume Reviews
    match /placement_applications/{appId} {
      allow read: if isAdmin() || isPlacementOfficer() || (isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.studentUid == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        resource.data.studentEmail == request.auth.token.email
      ));
      allow create: if isAdmin() || isPlacementOfficer() || (isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid ||
        request.resource.data.studentUid == request.auth.uid ||
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.email == request.auth.token.email ||
        request.resource.data.studentEmail == request.auth.token.email
      ));
      allow update, delete: if isAdmin() || isPlacementOfficer() || (isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.studentUid == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        resource.data.email == request.auth.token.email
      ));
    }
    match /resumeReviews/{reviewId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /resumes/{resumeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /placement_interviews/{interviewId} {
      allow read: if isAuthenticated();
      allow write: if isPlacementOfficer();
    }
    match /placement_trainings/{trainingId} {
      allow read: if isAuthenticated();
      allow write: if isPlacementOfficer();
    }

    // Leave Requests
    match /leave_requests/{leaveId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /student_leaves/{leaveId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /facultyLeaves/{leaveId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /faculty_leaves/{leaveId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Subject Allocations
    match /subject_allocations/{allocId} {
      allow read: if isAuthenticated();
      allow write: if isHOD();
    }
    match /facultyAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isHOD() || isAdmin() || isPrincipal();
    }
    match /wardCounsellorAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isHOD() || isAdmin() || isPrincipal();
    }

    // Academic Calendar, Timetables, Classrooms
    match /academic_calendar/{calId} {
      allow read: if isAuthenticated();
      allow write: if isPrincipal() || isAdmin();
    }
    match /timetables/{ttId} {
      allow read: if isAuthenticated();
      allow write: if isHOD() || isPrincipal() || isAdmin();
    }
    match /classrooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if isHOD() || isPrincipal() || isAdmin();
    }

    // Announcements & Notifications
    match /announcements/{annId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Audit & Backup Logs
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /backup_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isPrincipal();
    }

    // Counselling Meetings & Logs
    match /counselling_meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow write: if isCounsellor() || isHOD();
    }
    match /counselling_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isCounsellor() || isHOD();
    }
    match /parent_meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow write: if isCounsellor() || isHOD();
    }

    // Library & Document Requests & Grievances
    match /books/{bookId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /issued_books/{issueId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /document_requests/{reqId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /grievances/{grievanceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
