rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /assignments/{assignmentId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'faculty' || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin');
    }
    match /submissions/{assignmentId}/{studentId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == studentId || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'faculty' || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin');
      allow write: if request.auth != null && request.auth.uid == studentId;
    }
  }
}
